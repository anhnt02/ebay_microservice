{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "PaymentShipping": "Debug"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=sqlserver;Database=PaymentShippingDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "this-is-a-super-secret-key-for-jwt-that-needs-to-be-long-enough-32bytes",
    "Issuer": "PaymentShippingApi",
    "Audience": "PaymentShippingClient",
    "ExpiryMinutes": "1440"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "PayPal": {
    "BaseUrl": "https://api-m.sandbox.paypal.com",
    "ClientId": "SIMULATED_CLIENT_ID",
    "ClientSecret": "SIMULATED_CLIENT_SECRET",
    "Currency": "USD",
    "Simulated": true
  },
  "Payment": {
    "SecretKey": "super-secret-key-for-payment-callbacks-only"
  },
  "Email": {
    "Host": "mailhog",
    "Port": "1025",
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@paymentshipping.local",
    "FromName": "PaymentShipping System",
    "EnableSsl": false
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
